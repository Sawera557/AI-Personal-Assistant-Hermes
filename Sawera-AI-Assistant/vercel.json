{
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["hermes/**"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "app.py" }
  ],
  "crons": [
    {
      "path": "/api/scheduled-tasks/run-due",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/jobs/run-due",
      "schedule": "*/15 * * * *"
    }
  ]
}
