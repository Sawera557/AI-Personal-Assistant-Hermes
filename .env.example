# ---- Hermes AI Agent — copy this file to ".env" and fill in your keys ----

# Anthropic (Claude) API key — https://platform.claude.com/settings/keys  (starts with sk-ant-)
ANTHROPIC_API_KEY=

# Maton API key — https://maton.ai/api-keys
MATON_API_KEY=

# OpenAI API key — used for voice mode (speech-to-text + text-to-speech).
# https://platform.openai.com/api-keys  •  Leave blank to disable the voice button.
# The voice agent's brain stays Claude (same apps as the typed chat); OpenAI just
# does the listening and the speaking. Server-side only — never sent to browser.
OPENAI_API_KEY=

# Groq API key — alternative voice provider (set VOICE_PROVIDER=groq to use it).
GROQ_API_KEY=

# ---- Optional settings (sensible defaults shown) ----
HERMES_MODEL=claude-sonnet-5
# Reasoning effort — low | medium | high (frontend can override per request).
HERMES_EFFORT=low
# Max output tokens per turn; raise for longer/deeper responses.
HERMES_MAX_TOKENS=8000
# Ceiling the agent auto-grows a turn's output budget to when a reply is cut off
# by the token cap (doubles until it finishes or hits this). Default: 4x MAX_TOKENS.
HERMES_MAX_TOKENS_CEILING=32000
# Max tool-use loops per turn; raise for more complex multi-step tasks.
HERMES_MAX_TOOL_ITERATIONS=12
# Dedicated fast model for the live meeting copilot (real-time guidance bullets).
HERMES_GUIDANCE_MODEL=claude-haiku-4-5-20251001
HERMES_APPS=quickbooks,pdf-co,google-contacts,fathom,google-meet,google-forms,google-sheets,google-docs,google-drive,google-calendar,google-mail,zoom,wati,jira
HERMES_WEB_SEARCH=true
PORT=5000

# Comma-separated list of origins allowed to call the API (CORS). Use "*" to
# allow any origin (fine for testing); lock this to your frontend in production,
# e.g. CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# ---- Scheduled Tasks ----
# Tasks fire when a cron pings POST/GET /api/scheduled-tasks/run-due. Protect
# that endpoint with a secret so only your scheduler can trigger runs. On Vercel,
# set CRON_SECRET (Vercel Cron sends it automatically as a Bearer token, and the
# vercel.json `crons` entry hits run-due every 15 min); SCHEDULER_SECRET works
# identically for any other cron (cron-job.org, GitHub Actions, curl). Either is
# accepted. If both are unset the endpoint is open — only OK for local dev.
# SCHEDULER_SECRET=change-me
# CRON_SECRET=change-me
# Timezone new tasks default to (per-task overridable in the UI).
SCHEDULER_DEFAULT_TZ=America/Chicago
# On an always-on process (local dev, a VM, Railway/Render) the app also runs an
# in-process poller so tasks fire with no external cron needed — it's ON by
# default everywhere EXCEPT Vercel (where the vercel.json cron handles firing).
# Override with SCHEDULER_INPROCESS=true/false; tune the scan interval below.
# SCHEDULER_INPROCESS=true
SCHEDULER_POLL_SECONDS=60

# ---- Jobs (code-driven cron jobs — the Jobs tab) ----
# Jobs fire via the same pull-based cron as Scheduled Tasks: a cron pings
# POST/GET /api/jobs/run-due (protected by SCHEDULER_SECRET / CRON_SECRET above;
# the vercel.json `crons` entry hits it daily). The first job is a Google-reviews
# scraper for hammams/spas that writes a daily CSV to S3.
#
# SerpAPI is the (pluggable) review provider. Free tier = 100 searches/mo, so the
# scraper defaults to ONE bucket per day on rotation at a small per-run budget.
# SERPAPI_API_KEY=
# Where the daily CSV lands: s3://$S3_BUCKET/<prefix>/<YYYY-MM-DD>.csv
REVIEWS_S3_PREFIX=google-reviews

# ---- Voice mode ----
# Which provider does the voice I/O: "openai" (default) or "groq".
VOICE_PROVIDER=openai
# Language the voice agent listens and replies in (ISO-639-1). English only.
VOICE_LANGUAGE=en
# Extra brand/product/client names speech-to-text keeps mishearing (comma-
# separated). They're fed to the recognizer so it spells them right.
VOICE_VOCAB=

# OpenAI voice overrides. Voices: alloy, ash, ballad, coral, echo, fable, onyx,
# nova, sage, shimmer, verse.
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Groq voice overrides (only used when VOICE_PROVIDER=groq). Orpheus needs a
# one-time terms acceptance at https://console.groq.com/playground
# Orpheus voices: autumn, diana, hannah (female) / austin, daniel, troy (male).
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn

# ---- Postgres (AWS RDS) — the record keeper ----
# Two auth modes (auto-selected): set DB_PASSWORD for password auth, OR leave it
# blank to use IAM auth (an RDS token is generated from the AWS keys below).
DBRDS_HOST=your-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DBRDS_PORT=5432
DBRDS_USER=postgres
DB_NAME=postgres
# DB_PASSWORD=                 # set this for password auth; blank => IAM auth
# PGSSLMODE=verify-full        # use with PGSSLROOTCERT for full cert verification
# PGSSLROOTCERT=/path/to/rds-global-bundle.pem

# AWS (used for IAM DB auth + S3). Prefer a secrets manager in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# S3 — the locker for real file bytes. Optional: if blank, ingestion still
# records + indexes documents, but original bytes are not stored to S3.
S3_BUCKET=

# ---- Vector search (pgvector, on the same Postgres instance as everything
# else — no separate vector service) ----
# Embeddings (OpenAI). 3-small => 1536 dims; 3-large => 3072. Changing this
# later requires an explicit re-embed migration — the `vector` columns are
# fixed-dimension (see hermes/db/migrations/0008_pgvector.sql).
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# ---- Persistent memory (owner/business/project/decision) ----
MEMORY_EXTRACT_ENABLED=true
MEMORY_DUP_THRESHOLD=0.92
MEMORY_UPDATE_THRESHOLD=0.75
MEMORY_ALWAYS_INJECT_MAX=20
MEMORY_SEMANTIC_TOP_K=5
MEMORY_MAX_SENSITIVITY=confidential

# ---- Owner notification channel (hermes/notify.py) ----
# The daily attention report is emailed to OWNER_EMAIL, and any scheduled task
# with a "Notify to" address gets its result + files emailed there after each run.
# OWNER_EMAIL also decides who owns chats/tasks — set it to the real owner inbox.
# OWNER_EMAIL=owner@example.com
# Which business's connected Gmail sends the mail (no dedicated Hermes sender
# yet). Unset => first business with a connected Maton key.
# HERMES_NOTIFY_BUSINESS=afk
# Public origin for the "#task/<id>" deep links in those emails. On Vercel this
# defaults to https://$VERCEL_URL when unset.
# PUBLIC_BASE_URL=https://your-hermes-host.example.com
    