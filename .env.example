# ---- Hermes AI Agent — copy this file to ".env" and fill in your keys ----

# Anthropic (Claude) API key — https://platform.claude.com/settings/keys  (starts with sk-ant-)
ANTHROPIC_API_KEY=

# Maton API key — https://maton.ai/api-keys
MATON_API_KEY=

# OpenAI API key — used for voice mode (speech-to-text + text-to-speech).
# https://platform.openai.com/api-keys  •  Leave blank to disable the voice button.
# The voice agent's brain stays Claude (same apps as the typed chat); OpenAI just
# does the listening and the speaking. Server-side only — never sent to browser.
OPENAI_API_KEY=

# Groq API key — alternative voice provider (set VOICE_PROVIDER=groq to use it).
GROQ_API_KEY=

# ---- Optional settings (sensible defaults shown) ----
HERMES_MODEL=claude-opus-4-8
HERMES_EFFORT=medium
HERMES_MAX_TOKENS=8000
HERMES_APPS=quickbooks,pdf-co,google-contacts,fathom,google-meet,google-forms,google-sheets,google-docs,google-drive,google-calendar,google-mail
HERMES_WEB_SEARCH=true
FLASK_SECRET=change-me-to-a-random-string
PORT=5000

# ---- Voice mode ----
# Which provider does the voice I/O: "openai" (default) or "groq".
VOICE_PROVIDER=openai

# OpenAI voice overrides. Voices: alloy, ash, ballad, coral, echo, fable, onyx,
# nova, sage, shimmer, verse.
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Groq voice overrides (only used when VOICE_PROVIDER=groq). Orpheus needs a
# one-time terms acceptance at https://console.groq.com/playground
# Orpheus voices: autumn, diana, hannah (female) / austin, daniel, troy (male).
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
