# ---- Hermes AI Agent — copy this file to ".env" and fill in your keys ----

# Anthropic (Claude) API key — https://platform.claude.com/settings/keys  (starts with sk-ant-)
ANTHROPIC_API_KEY=

# Maton API key — https://maton.ai/api-keys
MATON_API_KEY=

# OpenAI API key — used for voice mode (speech-to-text + text-to-speech).
# https://platform.openai.com/api-keys  •  Leave blank to disable the voice button.
# The voice agent's brain stays Claude (same apps as the typed chat); OpenAI just
# does the listening and the speaking. Server-side only — never sent to browser.
OPENAI_API_KEY=

# Groq API key — alternative voice provider (set VOICE_PROVIDER=groq to use it).
GROQ_API_KEY=

# NuExtract API key — bill/invoice OCR + document text extraction (official
# `numind` SDK; targets https://nuextract.ai). Blank = extraction falls back to
# Claude vision. https://nuextract.ai
NUEXTRACT_API_KEY=

# ---- Optional settings (sensible defaults shown) ----
# NuExtract host override (self-hosted/proxy only; blank = SDK default nuextract.ai).
NUEXTRACT_BASE_URL=
# NuExtract project id for structured (bill) extraction. Blank = send Hermes'
# per-call schema as a template. Set only if the project exposes the bill fields.
NUEXTRACT_PROJECT_ID=
# Wall-clock bound (seconds) per NuExtract call. Must stay comfortably UNDER the
# serverless function timeout, so a slow document fails in time for the
# Claude-vision fallback to run instead of the platform killing the request.
NUEXTRACT_TIMEOUT=45
HERMES_MODEL=claude-sonnet-5
# Reasoning effort — low | medium | high (frontend can override per request).
HERMES_EFFORT=low
# Max output tokens per turn; raise for longer/deeper responses.
HERMES_MAX_TOKENS=8000
# Ceiling the agent auto-grows a turn's output budget to when a reply is cut off
# by the token cap (doubles until it finishes or hits this). Default: 4x MAX_TOKENS.
HERMES_MAX_TOKENS_CEILING=32000
# Max tool-use loops per turn; raise for more complex multi-step tasks.
HERMES_MAX_TOOL_ITERATIONS=12
# Dedicated fast model for the live meeting copilot (real-time guidance bullets).
HERMES_GUIDANCE_MODEL=claude-haiku-4-5-20251001
HERMES_APPS=quickbooks,pdf-co,google-contacts,fathom,google-meet,google-forms,google-sheets,google-docs,google-drive,google-calendar,google-mail,zoom,wati,jira
HERMES_WEB_SEARCH=true
# Guardrail #1 default: require user confirmation before any external send/write
# (email, WhatsApp, Zoom invite, Jira, mutating maton_request). Runtime-toggleable
# per-business via the settings API; this is only the default. Keep on for safety.
HERMES_GUARDRAIL_CONFIRM_WRITES=true
# Guardrail #2 default: verify Pinecone knowledge results belong to the business
# in scope and drop cross-business matches (data-leak isolation). Runtime-toggleable
# per-business via the settings API; this is only the default. Keep on for safety.
HERMES_GUARDRAIL_BUSINESS_ISOLATION=true
PORT=5000

# Comma-separated list of origins allowed to call the API (CORS). Use "*" to
# allow any origin (fine for testing); lock this to your frontend in production,
# e.g. CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# ---- Scheduled Tasks ----
# Tasks fire when a cron pings POST/GET /api/scheduled-tasks/run-due. Protect
# that endpoint with a secret so only your scheduler can trigger runs. On Vercel,
# set CRON_SECRET (Vercel Cron sends it automatically as a Bearer token, and the
# vercel.json `crons` entry hits run-due every 15 min); SCHEDULER_SECRET works
# identically for any other cron (cron-job.org, GitHub Actions, curl). Either is
# accepted. If both are unset the endpoint is open — only OK for local dev.
# SCHEDULER_SECRET=change-me
# CRON_SECRET=change-me
# Timezone new tasks default to (per-task overridable in the UI).
SCHEDULER_DEFAULT_TZ=America/Chicago
# On an always-on process (local dev, a VM, Railway/Render) the app also runs an
# in-process poller so tasks fire with no external cron needed — it's ON by
# default everywhere EXCEPT Vercel (where the vercel.json cron handles firing).
# Override with SCHEDULER_INPROCESS=true/false; tune the scan interval below.
# SCHEDULER_INPROCESS=true
SCHEDULER_POLL_SECONDS=60

# ---- Jobs (code-driven cron jobs — the Jobs tab) ----
# Jobs fire via the same pull-based cron as Scheduled Tasks: a cron pings
# POST/GET /api/jobs/run-due (protected by SCHEDULER_SECRET / CRON_SECRET above;
# the vercel.json `crons` entry hits it daily). The first job is a Google-reviews
# scraper for hammams/spas that writes a daily CSV to S3.
#
# SerpAPI is the (pluggable) review provider. Free tier = 100 searches/mo, so the
# scraper defaults to ONE bucket per day on rotation at a small per-run budget.
# SERPAPI_API_KEY=
# Where the daily CSV lands: s3://$S3_BUCKET/<prefix>/<YYYY-MM-DD>.csv
REVIEWS_S3_PREFIX=google-reviews

# ---- Voice mode ----
# Which provider does the voice I/O: "openai" (default) or "groq".
VOICE_PROVIDER=openai
# Language the voice agent listens and replies in (ISO-639-1). English only.
VOICE_LANGUAGE=en
# Extra brand/product/client names speech-to-text keeps mishearing (comma-
# separated). They're fed to the recognizer so it spells them right.
VOICE_VOCAB=

# OpenAI voice overrides. Voices: alloy, ash, ballad, coral, echo, fable, onyx,
# nova, sage, shimmer, verse.
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Groq voice overrides (only used when VOICE_PROVIDER=groq). Orpheus needs a
# one-time terms acceptance at https://console.groq.com/playground
# Orpheus voices: autumn, diana, hannah (female) / austin, daniel, troy (male).
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn

# ---- Postgres (AWS RDS) — the record keeper ----
# Two auth modes (auto-selected): set DB_PASSWORD for password auth, OR leave it
# blank to use IAM auth (an RDS token is generated from the AWS keys below).
DBRDS_HOST=your-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DBRDS_PORT=5432
DBRDS_USER=postgres
DB_NAME=postgres
# DB_PASSWORD=                 # set this for password auth; blank => IAM auth
# PGSSLMODE=verify-full        # use with PGSSLROOTCERT for full cert verification
# PGSSLROOTCERT=/path/to/rds-global-bundle.pem

# AWS (used for IAM DB auth + S3). Prefer a secrets manager in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# S3 — the locker for real file bytes. Optional: if blank, ingestion still
# records + indexes documents, but original bytes are not stored to S3.
S3_BUCKET=

# Public origin for PERMANENT, NO-LOGIN download links to agent-generated files
# (create_file output under the generated/ prefix). Leave blank to keep every
# link private + presigned. Must be the BUCKET origin, not an Access Point host
# (access points never serve anonymous requests):
#   S3_PUBLIC_BASE_URL=https://<bucket>.s3.<region>.amazonaws.com
# Setting this alone does nothing — AWS must also allow anonymous reads on that
# prefix. In the S3 console, on the underlying bucket:
#   1. Permissions -> Block public access -> uncheck "Block public access to
#      buckets and objects granted through new public bucket policies" and the
#      "...through any public bucket policies" option. Leave the two ACL blocks ON.
#   2. Permissions -> Bucket policy -> add (note: GetObject only, no ListBucket,
#      so the bucket cannot be enumerated — keys carry a uuid4 and are unguessable):
#      {
#        "Version": "2012-10-17",
#        "Statement": [{
#          "Sid": "PublicReadGeneratedFiles",
#          "Effect": "Allow",
#          "Principal": "*",
#          "Action": "s3:GetObject",
#          "Resource": "arn:aws:s3:::<bucket>/generated/*"
#        }]
#      }
# Scope is deliberately generated/* only: ingested source documents, email
# attachments and WATI media stay private. Anything Hermes writes here is world-
# readable to anyone who gets the URL, forever — do not generate files containing
# secrets, PHI, or personal data while this is on.
S3_PUBLIC_BASE_URL=

# ---- Vector search (pgvector, on the same Postgres instance as everything
# else — no separate vector service) ----
# Embeddings (OpenAI). 3-small => 1536 dims; 3-large => 3072. Changing this
# later requires an explicit re-embed migration — the `vector` columns are
# fixed-dimension (see hermes/db/migrations/0008_pgvector.sql).
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# ---- Persistent memory (owner/business/project/decision) ----
MEMORY_EXTRACT_ENABLED=true
MEMORY_DUP_THRESHOLD=0.92
MEMORY_UPDATE_THRESHOLD=0.75
MEMORY_ALWAYS_INJECT_MAX=20
MEMORY_SEMANTIC_TOP_K=5
MEMORY_MAX_SENSITIVITY=confidential

# ---- RAG on Pinecone + always-on context (hermes/rag.py, pinecone_store.py) ----
# The autopilot ingestion-service embeds each business's emails/Drive/meeting
# notes into Pinecone (index `hermes`, namespace entity__<slug>, same 1536-dim
# text-embedding-3-small + sensitivity metadata as pgvector). These let the MAIN
# app READ that index so search_business_knowledge and the always-on context
# block reach the full corpus, not just the hand-added Context-tab notes.
# Use the SAME Pinecone values the ingestion-service uses.
PINECONE_API_KEY=
PINECONE_INDEX=hermes
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Master switches (both default OFF so this merges dark):
#   HERMES_RAG_PINECONE          — federated search also queries Pinecone (needs a key).
#   HERMES_RAG_CONTEXT_INJECTION — inject the RETRIEVED CONTEXT block into the
#                                  system prompt every turn (always-on RAG).
# Set BOTH true to get "business data + context files considered on each query".
HERMES_RAG_PINECONE=false
HERMES_RAG_CONTEXT_INJECTION=false
HERMES_RAG_TOP_K=6
HERMES_RAG_MAX_SENSITIVITY=confidential
# Min cosine similarity for a chunk to enter the always-on block (keeps
# small-talk turns from injecting weak matches). Raise to be stricter.
HERMES_RAG_SCORE_THRESHOLD=0.30
HERMES_RAG_CONTEXT_MAX_CHARS=6000

# ---- Conversation-history memory (Phase 2 — hermes/conversation_retrieve.py) ----
# Recall of PAST conversations (verbatim turns + extractive summaries) in the
# conversation_memory table (migration 0018, pgvector — separate from the
# Pinecone business RAG so they never share a failure). Two independent switches
# (both default OFF — dark merge). Turn WRITE on first to backfill history, then
# turn recall on:
#   HERMES_CONVO_MEMORY_WRITE  — record each finished turn (+ summary).
#   HERMES_CONVO_MEMORY        — inject the EARLIER CONVERSATIONS recall block.
HERMES_CONVO_MEMORY_WRITE=false
HERMES_CONVO_MEMORY=false
HERMES_CONVO_MEMORY_TOP_K=6
# Precision-favouring threshold (higher than RAG): a weak conversation match
# reads as "you said X" and is worse than silence.
HERMES_CONVO_MEMORY_SCORE_THRESHOLD=0.35
HERMES_CONVO_MEMORY_MAX_CHARS=4000
# Verbatim 'turn' rows older than this are pruned; summaries are kept forever.
HERMES_CONVO_MEMORY_TTL_DAYS=45

# ---- Owner notification channel (hermes/notify.py) ----
# The daily attention report is emailed to OWNER_EMAIL, and any scheduled task
# with a "Notify to" address gets its result + files emailed there after each run.
# OWNER_EMAIL also decides who owns chats/tasks — set it to the real owner inbox.
# OWNER_EMAIL=owner@example.com
# Which business's connected Gmail sends the mail (no dedicated Hermes sender
# yet). Unset => first business with a connected Maton key.
# HERMES_NOTIFY_BUSINESS=afk
# Public origin for the "#task/<id>" deep links in those emails, and for the
# never-expiring create_file download links. On Vercel this defaults to
# https://$VERCEL_URL when unset — set it explicitly to your stable production
# domain so shared file links keep working across deploys. Without it, create_file
# falls back to a raw presigned S3 URL that dies after 24 hours.
# PUBLIC_BASE_URL=https://your-hermes-host.example.com
