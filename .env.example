# ---- Hermes AI Agent — copy this file to ".env" and fill in your keys ----

# Anthropic (Claude) API key — https://platform.claude.com/settings/keys  (starts with sk-ant-)
ANTHROPIC_API_KEY=

# Maton API key — https://maton.ai/api-keys
MATON_API_KEY=

# Groq API key — voice mode only (speech-to-text + text-to-speech).
# https://console.groq.com/keys  •  Leave blank to disable the voice call button.
# The voice agent's brain stays Claude (same apps as the typed chat); Groq just
# does the listening and the speaking. Server-side only — never sent to browser.
GROQ_API_KEY=

# ---- Optional settings (sensible defaults shown) ----
HERMES_MODEL=claude-opus-4-8
HERMES_EFFORT=medium
HERMES_MAX_TOKENS=8000
HERMES_APPS=quickbooks,pdf-co,google-contacts,fathom,google-meet,google-forms,google-sheets,google-docs,google-drive,google-calendar,google-mail
HERMES_WEB_SEARCH=true
FLASK_SECRET=change-me-to-a-random-string
PORT=5000

# ---- Voice mode (Groq) — optional overrides ----
# TTS uses Orpheus (PlayAI was retired). Accept the model terms once at
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# Orpheus voices: autumn, diana, hannah (female) / austin, daniel, troy (male).
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
